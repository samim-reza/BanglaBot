# Settings for the Callisa voice & chat agent platform.
#
# Copy to `.env` at the repo root (backend/.env also works; it is read after
# this one). Real environment variables override both. Every key below is read
# by backend/app/core/config.py (Settings).

# --- App -------------------------------------------------------------------
APP_NAME=Callisa
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated portal origins allowed by CORS; each entry's www / apex twin is added
# (https://www.banglabot.xyz also allows https://banglabot.xyz). Outside production,
# localhost:3000 / :5173 and ngrok / trycloudflare tunnels are allowed too. The chat
# widget's endpoints (/api/public/widget*) answer any website regardless.
# ENVIRONMENT=production also turns on HSTS and the secret checks below.
FRONTEND_ORIGIN=http://localhost:3000

# --- Storage ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/banglabot
DATABASE_SSL=false
DATABASE_SSL_VERIFY=false
# Optional; the app runs without Redis.
REDIS_URL=redis://localhost:6379/0

# --- Auth & security -----------------------------------------------------------
# With ENVIRONMENT=production the server REFUSES TO START while ADMIN_TOKEN_SECRET is a
# default or shorter than 32 chars, ADMIN_PASSWORD is a default / weak, or
# ENCRYPTION_SECRET is missing. Development only logs a warning, so these defaults work.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Seeds the first superadmin on first boot (while the admin_users table is empty); after
# that admins (roles superadmin / support / finance, optional 2FA) are managed in the
# admin console and these two only sign in while no admin user exists.
ADMIN_USERNAME=admin
# Production: 10+ characters, not common, not the username.
ADMIN_PASSWORD=admin@1234
# Signs session tokens (and, unless TELNYX_WEBHOOK_SECRET is set, the Telnyx webhook
# URLs). JWT_SECRET is accepted as an alias. Changing it signs everyone out.
ADMIN_TOKEN_SECRET=change-me-admin-token-secret
# While rotating: put the old secret here for a while — sessions, Telnyx URLs and data
# encrypted under it keep working until they are reissued. Empty otherwise.
ADMIN_TOKEN_SECRET_PREVIOUS=
# Session lifetimes (hours): account owners / platform admins.
MERCHANT_SESSION_TTL_HOURS=72
ADMIN_SESSION_TTL_HOURS=12
# Reverse proxies in front of the app that append to X-Forwarded-For (Render = 1). The
# client IP for rate limits is taken that many entries from the right; 0 = ignore the
# header (app exposed directly).
TRUSTED_PROXY_HOPS=1
# Largest request body in bytes: everything (CSV imports) / public + webhook endpoints.
MAX_REQUEST_BYTES=2000000
MAX_PUBLIC_REQUEST_BYTES=65536
# Owner-typed URLs (webhooks, iCal links) may reach localhost / private networks.
# Development only: production refuses to start with it on.
OUTBOUND_ALLOW_PRIVATE=false
# FastAPI's /docs and /openapi.json. Empty = on outside production, off in production.
EXPOSE_API_DOCS=

# --- OpenAI: streaming STT + the call brain ------------------------------------
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.4-mini
OPENAI_LLM_REASONING_EFFORT=none
OPENAI_LLM_MAX_OUTPUT_TOKENS=300
# Optional extended prompt-cache retention ("24h") if the model supports it; leave empty otherwise.
OPENAI_PROMPT_CACHE_RETENTION=
# gpt-4o-mini-transcribe is the cheap default for phone audio.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Microphone profile for the transcriber's noise suppression (near_field = phone).
OPENAI_NOISE_REDUCTION=near_field
STT_VAD_THRESHOLD=0.5
STT_VAD_PREFIX_PADDING_MS=300
STT_VAD_SILENCE_DURATION_MS=600

# --- Azure Speech TTS (backup English voice; voice = persona x region accent) ------
# female = en-US-AvaNeural, male = en-US-AndrewNeural (the region picks en-GB, en-AU, ...)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
TTS_VOICE_PERSONA=female
TTS_SPEAKING_RATE=0%
TTS_CACHE_DIR=.tts-cache
TTS_CACHE_MAX_ENTRIES=5000
TTS_CACHE_MAX_MB=500

# --- Call behaviour ------------------------------------------------------------------
# Platform default cap on one call when an account leaves max_call_seconds at 0.
VOICE_MAX_CALL_SECONDS=240
# Inbound calls (booking a doctor / technician / viewing) take longer.
VOICE_MAX_INBOUND_CALL_SECONDS=480
# Record inbound calls too (Telnyx recording, started when the stream connects).
VOICE_RECORD_INBOUND=true

# --- Bulk dialer ("Call all" button + scheduled auto call) ---
# Calls a merchant may have live at once during a batch (a new Telnyx account allows 2
# concurrent outbound calls in total until it is upgraded).
BULK_CALL_MAX_CONCURRENT=3
# Orders already dialed this many times are left out of batches.
BULK_CALL_MAX_ATTEMPTS=3
# Pause between two originations in a batch (seconds).
BULK_CALL_GAP_SECONDS=1.5
# A scheduled auto call found this far past its time (server was down) is skipped.
AUTO_CALL_MAX_LATE_MINUTES=120
# Say a cached "Okay." the instant a caller turn lands (masks model latency).
VOICE_INSTANT_ACK=true
# Telnyx answering-machine detection: hang up on voicemail, order stays callable.
VOICE_MACHINE_DETECTION=true
# Hang up when the carrier reports the call forwarded to a different number (Telnyx
# doesn't report forwards, so this has no effect there).
VOICE_HANGUP_ON_FORWARDED=false
VOICE_SPEECH_START_MIN_RMS=450
VOICE_BARGE_IN_MIN_RMS=1100
VOICE_BARGE_IN_MIN_FRAMES=20

# --- Telnyx (inbound + outbound calls, SMS) ---------------------------------------------
# Portal → Keys & Credentials → API Keys.
TELNYX_API_KEY=
# Programmable Voice → TeXML Applications: the app the number is assigned to. Its voice
# webhook is the SIGNED URL {PUBLIC_BASE_URL}/telnyx/inbound/<sig> (POST) — set it with
# `python -m scripts.telnyx_route prod` (or TELNYX_AUTO_CONFIGURE_INBOUND below); the app
# also needs an Outbound Voice Profile.
TELNYX_TEXML_APP_ID=
# The platform number (E.164). TELNYX_PHONE_NUMBER is accepted as an alias.
TELNYX_FROM_NUMBER=
# Telnyx user id for the account-scoped TeXML API. Optional: when empty it's learned from
# the first webhook and logged as "telnyx_account_sid_learned" — copy it here.
TELNYX_ACCOUNT_SID=
# Public https origin Telnyx can reach (status callbacks + media websocket),
# e.g. an ngrok tunnel.
PUBLIC_BASE_URL=
# Every Telnyx webhook URL ends in an HMAC signature (/telnyx/inbound/<sig>, per-call
# callbacks /telnyx/status/<id>/<sig>, ...). This secret signs them; empty = derived
# from ADMIN_TOKEN_SECRET. Set it (32+ chars) so rotating the token secret doesn't
# change the URLs Telnyx has. Changing it means repointing the TeXML app.
TELNYX_WEBHOOK_SECRET=
# Unsigned /telnyx/* URLs and unsigned Twilio WhatsApp posts are refused. Empty = on in
# production, off elsewhere; false = accept them (logged as a weakened control at boot).
# Point the TeXML app and the messaging profile at the signed URLs first:
#   python -m scripts.telnyx_route prod
ENFORCE_WEBHOOK_SIGNATURES=
# Base64 Ed25519 key (Keys & Credentials → Public Key; not available on pretrial
# accounts). When set, Telnyx's request signatures are verified too, automatically.
TELNYX_PUBLIC_KEY=
# Inbound calls: each account's "inbound number" (set in the admin console) routes calls
# to its agent; calls to a number no account has claimed are answered "not in service".
# On startup, point the TeXML app's voice webhook at {PUBLIC_BASE_URL}/telnyx/inbound/<sig>
# (handy with ngrok, whose URL changes every run). This edits your Telnyx app's config.
TELNYX_AUTO_CONFIGURE_INBOUND=false

# --- SMS confirmations & reminders (Telnyx Messaging; same account as calls) ---------------
# Global switch; each account turns texts on and picks events in Portal → Add-ons.
SMS_ENABLED=true
# Messaging Profiles: the profile the sender number is assigned to (its webhook: the
# signed {PUBLIC_BASE_URL}/telnyx/sms-events/<sig> — `python -m scripts.telnyx_route prod
# --dry-run --show-signature` prints it). US texting from a local number needs 10DLC.
TELNYX_MESSAGING_PROFILE_ID=
# SMS-capable sender; empty falls back to TELNYX_FROM_NUMBER.
TELNYX_SMS_FROM=
# How often the reminder sender looks for upcoming appointments / visits / viewings (seconds).
SMS_REMINDER_INTERVAL_SECONDS=300
# Abuse caps: texts per day per account / per destination number.
SMS_DAILY_CAP_PER_ACCOUNT=300
SMS_DAILY_CAP_PER_NUMBER=10

# --- Calendar sync ---------------------------------------------------------------------------
# The booking feed (/api/public/calendar/<token>.ics) and iCal busy links need nothing here;
# calendar apps can only reach the feed once PUBLIC_BASE_URL is a public https address.
# Google Calendar two-way sync: Google Cloud Console → APIs & Services → enable "Google
# Calendar API" → OAuth consent screen → Credentials → OAuth client ID (Web application),
# with this authorised redirect URI:  {PUBLIC_BASE_URL}/api/integrations/google/callback
# (http://localhost:8000/api/integrations/google/callback for local tests).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the redirect URI differs from the default above.
GOOGLE_REDIRECT_URI=
# How long imported busy times are reused before refetching (seconds).
CALENDAR_BUSY_CACHE_SECONDS=300
# Encrypts secrets at rest — Google / Messenger tokens, webhook signing secrets, calendar
# feed tokens, admin 2FA secrets — and peppers the calendar-token lookup hash. Required
# in production (32+ chars). Data encrypted before it was set (under ADMIN_TOKEN_SECRET)
# still decrypts. To rotate it, move the old value to ENCRYPTION_SECRET_PREVIOUS.
ENCRYPTION_SECRET=
ENCRYPTION_SECRET_PREVIOUS=

# --- Chat channels (add-ons) ----------------------------------------------------------------
# WhatsApp bot: runs on a Twilio WhatsApp sender (calls and SMS are on Telnyx).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# In Twilio, set the WhatsApp sender's
# "When a message comes in" webhook to {PUBLIC_BASE_URL}/twilio/whatsapp, then assign the
# sender's number to the account in the admin console (Accounts → account → WhatsApp number).
# Messenger bot: a Meta app with the Messenger product. Webhook URL {PUBLIC_BASE_URL}/api/meta/webhook,
# verify token = META_VERIFY_TOKEN, subscribe to "messages". Owners connect their Facebook Page
# (Page ID + Page access token) in the portal under Channels.
# Instagram DM + WhatsApp (Meta Cloud API) use the same app, secret, verify token and webhook URL:
# subscribe the app to the "instagram" (messages) and "whatsapp_business_account" (messages) objects.
# Owners connect an Instagram account id + Page token / a WhatsApp phone number id + access token
# on the Channels page (each needs its add-on).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Jev (TypeSafe System One) — optional speed-up -------------------------------------------
# Decides natural yes/no answers on scripted steps ("yeah that works for me") in ~0.1–0.5 s
# instead of a full LLM turn. Empty = off. https://docs.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=0.8
TYPESAFE_MIN_CONFIDENCE=0.85

# --- Email (optional) ----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Callisa

# --- Voice engine providers (free tiers for testing; every chain falls through on errors / quota) ---
# Free keys: https://console.groq.com/keys · https://aistudio.google.com/app/apikey · https://console.deepgram.com ($200 credit)
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
# LLM chain (provider:model, tried in order). OpenAI is used only with LLM_ALLOW_PAID=true.
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.1-flash-lite,groq:qwen/qwen3.8-27b,gemini:gemini-3.8-flash,openai:gpt-5.4-mini
LLM_ALLOW_PAID=false
# auto = compact prompts on free tiers, cached prompts on OpenAI | compact | cached
LLM_PROMPT_PROFILE=auto
# Speech chains (names: local, deepgram, groq, openai / local, deepgram, azure, gemini, edge)
STT_CHAIN=local,deepgram,groq,openai
TTS_CHAIN=local,deepgram,azure,gemini,edge
# Local open-source speech server on the laptop GPU (scripts/speech.sh): Parakeet STT + Kokoro TTS
SPEECH_SERVER_URL=
SPEECH_SERVER_KEY=
# Shared audio cache tier (Supabase Storage bucket "tts-cache"; secret key from Project Settings → API keys)
SUPABASE_URL=https://loxiscjleuogleqhgdap.supabase.co
SUPABASE_SECRET_KEY=
TTS_SHARED_CACHE_BUCKET=tts-cache
# Verticals on the skill pipeline ("all", or e.g. "clinic,restaurant"); the rest use their legacy flow.
PIPELINE_VERTICALS=all

# --- Payments (booking payment links; billing checkout uses the same provider) ----------------
# dummy = our own test pay page ({FRONTEND_ORIGIN}/pay/<signed token>, a "Pay" button, no money
# moves) | stripe = Stripe Checkout (needs both Stripe keys below; falls back to dummy without them).
# Owners can instead use their own payment link (Portal → payment settings).
PAYMENT_PROVIDER=dummy
# Developers → API keys (sk_test_... while testing). Never commit a real key.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint {PUBLIC_BASE_URL}/api/payments/stripe/webhook, events
# checkout.session.completed / async_payment_succeeded / async_payment_failed / expired,
# charge.refunded → "Signing secret" (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Oldest Stripe-Signature timestamp accepted (seconds).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# How long a payment link works (hours; Stripe allows at most 24).
PAYMENT_LINK_TTL_HOURS=24
# How often unpaid "online payment required" holds are released (seconds).
PAYMENT_SWEEP_INTERVAL_SECONDS=60

# --- Finance (cost ledger, margins, cost guard) -------------------------------------------------
# Priced usage lines (usage_events) older than this are deleted; daily rollups are kept.
FINANCE_EVENT_RETENTION_DAYS=400
# Daily spend cap per provider in USD, e.g. openai=5,deepgram=3,azure=2 (empty = no caps; 0 blocks
# a provider). The admin console's caps override these per provider.
PROVIDER_DAILY_CAPS_USD=
# How often the finance jobs run: SMS metering, cap refresh, retention (seconds).
FINANCE_JOB_INTERVAL_SECONDS=300
