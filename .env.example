# Settings for the BanglaBot voice & chat agent platform.
#
# Copy to `.env` at the repo root (backend/.env also works; it is read after
# this one). Real environment variables override both. Every key below is read
# by backend/app/core/config.py (Settings).

# --- App -------------------------------------------------------------------
APP_NAME=BanglaBot Voice Agents
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS (localhost:3000 / :5173 and
# ngrok tunnels are always allowed in addition).
FRONTEND_ORIGIN=http://localhost:3000

# --- Storage ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/banglabot
DATABASE_SSL=false
DATABASE_SSL_VERIFY=false
# Optional; the app runs without Redis.
REDIS_URL=redis://localhost:6379/0

# --- Auth --------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@1234
# JWT_SECRET is accepted as an alias of ADMIN_TOKEN_SECRET.
ADMIN_TOKEN_SECRET=change-me-admin-token-secret
# Seeds the demo accounts on startup (idempotent; existing accounts are left alone):
# clinic/clinic123, realestate/realestate123, homeservice/homeservice123, shop/shop123, demo/demo123.
AUTO_SEED_DEMO_DATA=true
# Account whose website chat widget the public website embeds as a live demo.
DEMO_WIDGET_USERNAME=clinic

# --- OpenAI: streaming STT + the call brain ------------------------------------
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.4-mini
OPENAI_LLM_REASONING_EFFORT=none
OPENAI_LLM_MAX_OUTPUT_TOKENS=300
# Optional extended prompt-cache retention ("24h") if the model supports it; leave empty otherwise.
OPENAI_PROMPT_CACHE_RETENTION=
# gpt-4o-mini-transcribe is the cheap default and, on public benchmarks, also the
# better OpenAI choice for Bengali phone audio (gpt-4o-transcribe scored worse).
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Microphone profile for the transcriber's noise suppression (near_field = phone).
OPENAI_NOISE_REDUCTION=near_field
STT_VAD_THRESHOLD=0.5
STT_VAD_PREFIX_PADDING_MS=300
STT_VAD_SILENCE_DURATION_MS=600

# --- Azure Speech TTS (voice = persona x language) --------------------------------
# female = bn-BD-NabanitaNeural / en-US-AvaNeural, male = bn-BD-PradeepNeural / en-US-AndrewNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
TTS_VOICE_PERSONA=female
TTS_SPEAKING_RATE=0%
TTS_CACHE_DIR=.tts-cache
TTS_CACHE_MAX_ENTRIES=5000
TTS_CACHE_MAX_MB=500

# --- Call behaviour ------------------------------------------------------------------
# Platform default cap on one call when an account leaves max_call_seconds at 0.
VOICE_MAX_CALL_SECONDS=240
# Inbound calls (booking a doctor / technician / viewing) take longer.
VOICE_MAX_INBOUND_CALL_SECONDS=480
# Record inbound calls too (Twilio recording, started when the stream connects).
VOICE_RECORD_INBOUND=true

# --- Bulk dialer ("Call all" button + scheduled auto call) ---
# Calls a merchant may have live at once during a batch.
BULK_CALL_MAX_CONCURRENT=3
# Orders already dialed this many times are left out of batches.
BULK_CALL_MAX_ATTEMPTS=3
# Pause between two originations in a batch (seconds).
BULK_CALL_GAP_SECONDS=1.5
# A scheduled auto call found this far past its time (server was down) is skipped.
AUTO_CALL_MAX_LATE_MINUTES=120
# Say a cached "জি।"/"Okay." the instant a caller turn lands (masks model latency).
VOICE_INSTANT_ACK=true
# Twilio answering-machine detection: hang up on voicemail, order stays callable.
VOICE_MACHINE_DETECTION=true
# Hang up when Twilio reports the call forwarded to a different number (off: BD
# carriers stamp forwarded_from with the dialed number on normal answered calls).
VOICE_HANGUP_ON_FORWARDED=false
VOICE_SPEECH_START_MIN_RMS=450
VOICE_BARGE_IN_MIN_RMS=1100
VOICE_BARGE_IN_MIN_FRAMES=20

# --- Twilio (inbound + outbound calls) ---------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER is accepted as an alias of TWILIO_FROM_NUMBER.
TWILIO_FROM_NUMBER=
# Public https origin Twilio can reach (status callbacks + media websocket),
# e.g. an ngrok tunnel. TWILIO_PUBLIC_BASE_URL is accepted as an alias.
PUBLIC_BASE_URL=
ENFORCE_WEBHOOK_SIGNATURES=false
# Inbound calls: each account's "inbound number" (set in the admin console) routes calls
# to its agent. Calls to a number no account claimed go to this account (dev), if set.
DEFAULT_INBOUND_USERNAME=
# On startup, point TWILIO_FROM_NUMBER's voice webhook at {PUBLIC_BASE_URL}/twilio/inbound
# (handy with ngrok, whose URL changes every run). This edits your Twilio number's config.
TWILIO_AUTO_CONFIGURE_INBOUND=false

# --- SMS confirmations & reminders (Twilio Messaging; same account as calls) ---------------
# Global switch; each account turns texts on and picks events in Portal → Add-ons.
SMS_ENABLED=true
# Preferred sender: a Messaging Service SID (MG…). Required for US A2P 10DLC registration.
TWILIO_MESSAGING_SERVICE_SID=
# Otherwise an SMS-capable number; empty falls back to TWILIO_FROM_NUMBER.
# Trial Twilio accounts can only text numbers verified in the Twilio console.
TWILIO_SMS_FROM=
# How often the reminder sender looks for upcoming appointments / visits / viewings (seconds).
SMS_REMINDER_INTERVAL_SECONDS=300

# --- Calendar sync ---------------------------------------------------------------------------
# The booking feed (/api/public/calendar/<token>.ics) and iCal busy links need nothing here;
# calendar apps can only reach the feed once PUBLIC_BASE_URL is a public https address.
# Google Calendar two-way sync: Google Cloud Console → APIs & Services → enable "Google
# Calendar API" → OAuth consent screen → Credentials → OAuth client ID (Web application),
# with this authorised redirect URI:  {PUBLIC_BASE_URL}/api/integrations/google/callback
# (http://localhost:8000/api/integrations/google/callback for local tests).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the redirect URI differs from the default above.
GOOGLE_REDIRECT_URI=
# How long imported busy times are reused before refetching (seconds).
CALENDAR_BUSY_CACHE_SECONDS=300
# Encrypts stored Google refresh tokens (any long random string; falls back to
# ADMIN_TOKEN_SECRET). Changing it later means accounts reconnect Google once.
ENCRYPTION_SECRET=

# --- Chat channels (add-ons) ----------------------------------------------------------------
# WhatsApp bot: uses the Twilio account above. In Twilio, set the WhatsApp sender's
# "When a message comes in" webhook to {PUBLIC_BASE_URL}/twilio/whatsapp, then assign the
# sender's number to the account in the admin console (Accounts → account → WhatsApp number).
# For testing, Twilio's WhatsApp sandbox number routes to DEFAULT_INBOUND_USERNAME.
# Messenger bot: a Meta app with the Messenger product. Webhook URL {PUBLIC_BASE_URL}/api/meta/webhook,
# verify token = META_VERIFY_TOKEN, subscribe to "messages". Owners connect their Facebook Page
# (Page ID + Page access token) in the portal under Channels.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Jev (TypeSafe System One) — optional speed-up -------------------------------------------
# Decides natural yes/no answers on scripted steps ("yeah that works for me") in ~0.1–0.5 s
# instead of a full LLM turn. Empty = off. https://docs.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=0.8
TYPESAFE_MIN_CONFIDENCE=0.85

# --- Email (optional) ----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BanglaBot
